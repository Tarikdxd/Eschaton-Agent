{
  "name": "eschaton-code",
  "version": "2.1.1",
  "description": "Terminal coding agent that works with your own API key or a local DeepSeek model",
  "type": "module",
  "bin": {
    "eschaton": "dist/eschaton.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "node scripts/build.mjs",
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "eschaton",
    "deepseek",
    "coding-agent",
    "terminal",
    "tui",
    "byok",
    "ollama"
  ],
  "author": "Tarık Tozlu (@Tarikdxd)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarikdxd/Eschaton-Code.git"
  },
  "bugs": {
    "url": "https://github.com/Tarikdxd/Eschaton-Code/issues"
  },
  "homepage": "https://github.com/Tarikdxd/Eschaton-Code#readme"
