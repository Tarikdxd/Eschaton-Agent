{
  "name": "eschaton-code",
  "version": "2.0.1",
  "description": "Terminal coding agent that works with your own API key or a local DeepSeek model",
  "type": "module",
  "bin": {
    "eschaton": "dist/eschaton.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "dev": "bun src/cli.ts",
    "build": "node scripts/build.mjs",
    "build:sdk": "cd sdk && bun run build",
    "build:freebuff": "bun freebuff/cli/build.ts 0.0.0-dev",
    "test": "bun test ./tests/providers.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "allWorkspaces": [
    "agents",
    "cli",
    "common",
    "evals",
    "freebuff",
    "packages/agent-runtime",
    "packages/code-map",
    "packages/llm-providers",
    "scripts/tmux",
    "sdk"
  ],
  "keywords": [
    "eschaton",
    "deepseek",
    "coding-agent",
    "terminal",
    "tui",
    "byok",
    "ollama"
  ],
  "author": "Tarık Tozlu (@Tarikdxd)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarikdxd/Eschaton-Code.git"
  },
  "bugs": {
    "url": "https://github.com/Tarikdxd/Eschaton-Code/issues"
  },
  "homepage": "https://github.com/Tarikdxd/Eschaton-Code#readme"
}
