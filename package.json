{
  "name": "@tarikdxd/eschaton-code",
  "version": "1.3.0",
  "description": "Eschaton Code - Pixel-Perfect OpenCode Terminal Coding Agent with Multi-Provider DeepSeek Pool, Auto-Failover, and Unlimited Quota Session Trick",
  "type": "module",
  "bin": {
    "eschaton": "./bin/eschaton.js",
    "freebuff": "./bin/freebuff.js",
    "opencode": "./bin/eschaton.js"
  },
  "files": [
    "bin",
    "src",
    "cli",
    "common",
    "packages",
    "agents",
    "sdk",
    "freebuff",
    "server",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/eschaton.js",
    "dev": "bun --cwd cli dev",
    "dev:freebuff": "FREEBUFF_MODE=true bun --cwd cli dev",
    "build": "bun run build:freebuff",
    "build:sdk": "cd sdk && bun run build",
    "build:freebuff": "bun freebuff/cli/build.ts 0.0.0-dev"
  },
  "allWorkspaces": [
    "agents",
    "cli",
    "common",
    "evals",
    "freebuff",
    "packages/agent-runtime",
    "packages/code-map",
    "packages/llm-providers",
    "scripts/tmux",
    "sdk"
  ],
  "keywords": [
    "eschaton",
    "freebuff",
    "opencode",
    "claude-code",
    "antigravity",
    "tui",
    "terminal-agent",
    "coding-assistant"
  ],
  "author": "Tarık Tozlu (@Tarikdxd)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tarikdxd/Eschaton-Code.git"
  },
  "bugs": {
    "url": "https://github.com/Tarikdxd/Eschaton-Code/issues"
  },
  "homepage": "https://github.com/Tarikdxd/Eschaton-Code#readme"
}
